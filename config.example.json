{
  "display": {
    "brightness": 60,
    "mapping": "adafruit-hat-pwm",
    "slowdown": 3,
    "fps": 24,
    "mask_bad_pixels": true,
    "bad_pixels": [[32, 5]],
    "matrix_options": {"pwm_bits": 8, "limit_refresh_rate_hz": 100}
  },
  "manager": {
    "http_host": "0.0.0.0",
    "http_port": 8080,
    "api_token": null,
    "db_path": "data/pixelgrid.db",
    "rotation": [
      {"activity": "weather", "screen": "now", "duration": 120, "tags": ["active"], "group": "weather"},
      {"activity": "weather", "screen": "forecast", "duration": 120, "tags": ["active"], "group": "weather"},
      {"activity": "christmas", "screen": "snowflakes", "duration": 120, "tags": ["active"],
       "widgets": [{"name": "clock", "options": {"top": -1}}]},
      {"activity": "christmas", "screen": "christmas-lights", "duration": 120, "tags": ["active"],
       "widgets": [{"name": "clock", "options": {"top": -1}}]},
      {"activity": "christmas", "screen": "christmas-tree", "duration": 120, "tags": ["active"],
       "widgets": [{"name": "clock", "options": {"top": -1}}]},
      {"activity": "tetris", "screen": "play-keep", "duration": 120, "tags": []},
      {"activity": "snow-clock", "duration": 60, "tags": ["clock"]},
      {"activity": "clock", "duration": 60, "tags": []},
      {"activity": "tetris-clock", "duration": 60, "tags": ["clock"]}
    ],
    "shuffle": true,
    "debug": false,
    "startup_selftest": true
  },
  "run": {
    "activity": "snow",
    "duration": 3600
  },
  "activities": {
    "snow": {
      "rate": 6,
      "speed": 4,
      "drift": 0.25,
      "max_step": 1,
      "mound": 6,
      "shift_at": 0.15,
      "shift_rows": 5,
      "shift_interval": 2,
      "max_pile": 40,
      "melt_interval": 0.25,
      "floor": 0,
      "top_margin": 1,
      "floor_above_widget": null
    },
    "clock": {
      "timezone": "America/New_York",
      "time_format": "%-I:%M",
      "ampm_format": "%p",
      "date_format": "%a %b %-d",
      "font": "10x20",
      "small_font": "5x7",
      "color": "#ffffff",
      "date_color": "#ffffff",
      "date_gap": 5,
      "date_space": 2
    },
    "selftest": {
      "color_seconds": 1,
      "grid_seconds": 2,
      "rainbow_seconds": 4
    },
    "weather": {
      "latitude": 40.5068,
      "longitude": -74.2654,
      "units": "fahrenheit",
      "refresh": 600,
      "icon_set": "twemoji",
      "icon_size": 20,
      "icon_gap": 3,
      "hours": 2,
      "hour_icon_set": "pixel",
      "hour_icon_size": 9,
      "font": "10x20",
      "small_font": "4x6",
      "color": "#ffffff",
      "label_color": "#9a9ac0",
      "demo": 0,
      "now_seconds": null,
      "forecast_seconds": null,
      "days": 3,
      "forecast_icon_set": "twemoji",
      "forecast_icon_size": 16,
      "forecast_font": "5x7",
      "low_color": "#7080a8"
    },
    "tetris": {
      "play_keep_seconds": null,
      "move_interval": 0.08,
      "drop_interval": 0.04,
      "lock_delay": 0.15,
      "lookahead": 8,
      "temperature": 0,
      "misdrop_rate": 0,
      "ghost": 0.2,
      "piece_colors": "#00d8d8,#1a40ff,#ff7a00,#f0d000,#18d018,#a020f0,#f01010",
      "edge": 0.45,
      "end_pause": 3,
      "seed": null
    },
    "christmas": {
      "snowflakes_seconds": null,
      "size": 13,
      "min_per_row": 3,
      "max_per_row": 4,
      "spacing": 20,
      "speed": 5,
      "jitter": 2,
      "y_jitter": 5,
      "sway": 1,
      "colors": "#ffffff,#d8ecff,#a8d4ff",
      "christmas_lights_seconds": null,
      "light_rows": 2,
      "min_lights": 3,
      "max_lights": 4,
      "sag": 5,
      "row_sag": 6,
      "light_row_spacing": null,
      "wire_color": "#0e5a1c",
      "light_colors": "#ff1a1a,#1aff3a,#1a5aff,#ffb300,#ff5a00,#c81aff",
      "change_every": 3,
      "sparkle_every": 5,
      "glow": 0.15,
      "christmas_tree_seconds": null,
      "ornaments_per_tier": "3-4,5-6,6-8",
      "ornament_colors": "#e01a28,#ffc028,#2a5aff,#d0d0e0,#b020d0",
      "garlands": 4,
      "tree_light_spacing": 4
    }
  },
  "widgets": {
    "clock": {
      "date_format": "",
      "top": 8,
      "bottom": -1,
      "left": -1,
      "right": -1,
      "outline": 1,
      "outline_color": "#000000",
      "colon_raise": 1,
      "digit_bounce": 2,
      "colon_bounce": 2,
      "bounce_period": 1.0,
      "bounce_stagger": 0.2,
      "bounce_every": 5
    }
  },
  "presets": {
    "tetris-clock": {
      "activity": "tetris",
      "widgets": [
        {
          "name": "clock",
          "options": {
            "font": "6x10",
            "small_font": "4x6",
            "top": 4,
            "left": 2
          }
        }
      ]
    },
    "weather-test-now": {"activity": "weather", "options": {"demo": 3, "forecast_seconds": 0}},
    "weather-test-forecast": {"activity": "weather", "options": {"demo": 3, "now_seconds": 0}},
    "snow-clock": {
      "activity": "snow",
      "options": {"shift_at": 0, "max_pile": 30, "floor": 15, "melt_interval": 5},
      "widgets": [{"name": "clock", "options": {"font": "6x10", "small_font": "4x6", "bottom": 2, "right": 2}}]
    }
  }
}
