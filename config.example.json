{
  "display": {
    "brightness": 60,
    "mapping": "adafruit-hat-pwm",
    "slowdown": 5,
    "fps": 24,
    "mask_bad_pixels": true,
    "bad_pixels": [[32, 5]]
  },
  "manager": {
    "http_host": "0.0.0.0",
    "http_port": 8080,
    "api_token": null,
    "db_path": "data/pixelgrid.db",
    "random_modes": ["snow"],
    "random_duration": null,
    "startup_selftest": true
  },
  "run": {
    "state": "snow",
    "duration": 3600
  },
  "states": {
    "snow": {
      "rate": 6,
      "speed": 4,
      "drift": 0.25,
      "max_step": 1,
      "mound": 6,
      "shift_at": 0.15,
      "shift_rows": 5,
      "shift_interval": 2,
      "max_pile": 40
    },
    "clock": {
      "timezone": "America/New_York",
      "time_format": "%-I:%M",
      "ampm_format": "%p",
      "date_format": "%a %b %-d",
      "font": "10x20",
      "small_font": "5x7",
      "color": "#ffffff",
      "date_color": "#ffffff",
      "date_gap": 5,
      "date_space": 2
    },
    "selftest": {
      "color_seconds": 1,
      "grid_seconds": 2,
      "rainbow_seconds": 4
    }
  },
  "widgets": {
    "clock": {
      "date_format": "",
      "top": 8,
      "outline": 1,
      "outline_color": "#000000"
    }
  },
  "presets": {
    "snow-clock": {
      "state": "snow",
      "widgets": ["clock"]
    }
  }
}
