[Unit]
Description=Pixelgrid LED matrix display manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root for hardware PWM timing and real-time priority (least flicker).
WorkingDirectory=/home/jnufio/pixelgrid
ExecStart=/home/jnufio/pixelgrid/.venv/bin/python -u -m pixelgrid.manager
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
